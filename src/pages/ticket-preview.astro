---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Ticket page preview — Evntry"
  description="See an example of the public ticket page your guests receive when you publish an event with Evntry."
  ogTitle="Ticket page preview — Evntry"
  ogUrl="https://evntry.app/ticket-preview"
  canonical="https://evntry.app/ticket-preview"
  robots="noindex, follow"
>

<style is:global>
  .preview-page {
    min-height: 100vh;
    padding: 120px 6vw 96px;
    background:
      radial-gradient(circle at 80% 15%, rgba(255,92,26,0.09), transparent 32%),
      var(--bg);
  }
  .preview-intro { max-width: 820px; margin: 0 auto 28px; text-align: center; }
  .preview-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding: 5px 10px;
    border: 1px solid rgba(255,92,26,0.25);
    border-radius: 999px;
    background: var(--accent-dim);
    color: var(--accent);
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .preview-intro h1 {
    margin-bottom: 12px;
    font-size: clamp(38px, 6vw, 68px);
    text-align: center;
  }
  .preview-intro p { max-width: 580px; margin: 0 auto; color: var(--muted); font-size: 15px; line-height: 1.65; }
  .ticket-page-shell {
    max-width: 920px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: 0 28px 90px rgba(0,0,0,0.42);
  }
  .event-cover {
    position: relative;
    min-height: 260px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 38px;
    background:
      linear-gradient(180deg, transparent 20%, rgba(5,5,5,0.84) 100%),
      radial-gradient(circle at 74% 22%, rgba(255,172,92,0.9) 0 2%, transparent 2.5%),
      linear-gradient(125deg, #301208 0%, #b73d0b 42%, #130d0b 100%);
  }
  .event-cover::before,
  .event-cover::after {
    content: '';
    position: absolute;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 50%;
  }
  .event-cover::before { width: 360px; height: 360px; right: -60px; top: -185px; }
  .event-cover::after { width: 230px; height: 230px; right: 82px; top: -105px; }
  .event-cover-copy { position: relative; z-index: 1; max-width: 620px; }
  .event-type {
    display: block;
    margin-bottom: 10px;
    color: rgba(255,255,255,0.72);
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .event-cover h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(42px, 7vw, 76px);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .event-layout { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr); }
  .event-details { padding: 38px; }
  .event-meta { display: grid; gap: 18px; margin-bottom: 34px; }
  .meta-row { display: grid; grid-template-columns: 28px 1fr; gap: 12px; align-items: start; }
  .meta-icon { color: var(--accent); font-size: 18px; line-height: 1.35; text-align: center; }
  .meta-label { display: block; color: var(--muted); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }
  .meta-value { display: block; margin-top: 2px; color: var(--text); font-size: 15px; font-weight: 600; line-height: 1.45; }
  .event-description { padding-top: 28px; border-top: 1px solid var(--border); }
  .event-description h3 {
    margin-bottom: 10px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 24px;
    text-transform: uppercase;
  }
  .event-description p { color: var(--muted); font-size: 14px; line-height: 1.7; }
  .ticket-panel { padding: 38px 30px; border-left: 1px solid var(--border); background: var(--surface2); }
  .ticket-panel h3 {
    margin-bottom: 18px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 26px;
    text-transform: uppercase;
  }
  .ticket-option { padding: 18px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); }
  .ticket-name { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .ticket-name strong { color: var(--text); font-size: 14px; }
  .ticket-price { color: var(--accent); font-family: 'Fira Code', monospace; font-size: 14px; font-weight: 600; }
  .ticket-option p { margin-top: 8px; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .preview-button {
    display: block;
    width: 100%;
    margin-top: 16px;
    padding: 13px 18px;
    border: 0;
    border-radius: 8px;
    background: var(--accent-btn);
    color: #fff;
    font: 600 14px 'Figtree', sans-serif;
    text-align: center;
  }
  .preview-disclaimer { margin-top: 12px; color: var(--muted); font-size: 11px; line-height: 1.5; text-align: center; }
  .preview-actions { display: flex; justify-content: center; gap: 12px; margin-top: 30px; flex-wrap: wrap; }
  @media (max-width: 760px) {
    .nav-link, .nav-cta { display: none; }
    .hamburger { display: flex; }
    .preview-page { padding: 100px 5vw 72px; }
    .event-cover { min-height: 220px; padding: 28px 24px; }
    .event-layout { grid-template-columns: 1fr; }
    .event-details { padding: 28px 24px; }
    .ticket-panel { padding: 28px 24px; border-top: 1px solid var(--border); border-left: 0; }
  }
</style>

<main class="preview-page">
  <header class="preview-intro">
    <span class="preview-kicker">Permanent example · No purchase</span>
    <h1>Your guests see<br><em>the event, not the admin.</em></h1>
    <p>This maintained preview shows the public ticket page guests receive. It is an example event, so the button below does not process a payment.</p>
  </header>

  <article class="ticket-page-shell" aria-label="Example Evntry ticket page">
    <div class="event-cover">
      <div class="event-cover-copy">
        <span class="event-type">Live at The Lantern Room</span>
        <h2>Jazz Trio Night</h2>
      </div>
    </div>
    <div class="event-layout">
      <div class="event-details">
        <div class="event-meta">
          <div class="meta-row">
            <span class="meta-icon" aria-hidden="true">◷</span>
            <div>
              <span class="meta-label">Date &amp; time</span>
              <span class="meta-value">Friday, 24 October · Doors at 19:30</span>
            </div>
          </div>
          <div class="meta-row">
            <span class="meta-icon" aria-hidden="true">⌖</span>
            <div>
              <span class="meta-label">Venue</span>
              <span class="meta-value">The Lantern Room · Zagreb</span>
            </div>
          </div>
        </div>
        <div class="event-description">
          <h3>About the event</h3>
          <p>An intimate evening of modern jazz, standards, and original music. Your confirmation and QR ticket arrive by email immediately after checkout.</p>
        </div>
      </div>
      <aside class="ticket-panel">
        <h3>Tickets</h3>
        <div class="ticket-option">
          <div class="ticket-name">
            <strong>General admission</strong>
            <span class="ticket-price">€12.00</span>
          </div>
          <p>Entry for one guest. The price shown is exactly what the guest pays.</p>
        </div>
        <span class="preview-button" aria-disabled="true">Continue to tickets</span>
        <p class="preview-disclaimer">Preview only — no payment will be taken.</p>
      </aside>
    </div>
  </article>

  <div class="preview-actions">
    <a href="https://app.evntry.app" class="btn-primary">Create your event →</a>
    <a href="/pricing" class="btn-secondary">See pricing</a>
  </div>
</main>
</BaseLayout>