---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="404 — Page not found | Evntry"
  description="This page doesn't exist. Head back to Evntry to sell tickets for your next event."
  ogTitle="Page not found — Evntry"
  robots="noindex, follow"
>

<style is:global>
  body { min-height: 100vh; display: flex; flex-direction: column; }
  .error-page {
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 120px 6vw 80px; position: relative; overflow: hidden;
  }
  .error-page::before {
    content: '404'; position: absolute;
    font-family: 'Barlow Condensed', sans-serif; font-weight: 800;
    font-size: clamp(180px, 30vw, 360px); color: rgba(255,92,26,0.04); line-height: 1;
    letter-spacing: -0.02em; pointer-events: none; user-select: none;
    top: 50%; left: 50%; transform: translate(-50%, -50%);
  }
  .error-num { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: clamp(80px, 14vw, 160px); line-height: 1; color: var(--accent); letter-spacing: -0.02em; margin-bottom: 24px; position: relative; }
  .error-page h1 { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: clamp(28px, 4vw, 48px); line-height: 1; text-transform: uppercase; letter-spacing: 0.01em; color: var(--text); margin-bottom: 16px; position: relative; }
  .error-page p { font-size: 16px; color: var(--muted); max-width: 360px; line-height: 1.65; margin-bottom: 40px; position: relative; }
  .error-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; position: relative; }
  @media (max-width: 680px) {
    .nav-link, .nav-cta { display: none; }
    .hamburger { display: flex; }
    .error-page { padding: 100px 5vw 64px; }
  }
</style>

<main>
  <div class="error-page">
    <div class="error-num">404</div>
    <h1>Nothing here</h1>
    <p>The page you're looking for doesn't exist or has moved.</p>
    <div class="error-actions">
      <a href="/" class="btn-primary">Go to homepage</a>
      <a href="/blog.html" class="btn-secondary">Read the blog</a>
    </div>
  </div>
</main>
</BaseLayout>
