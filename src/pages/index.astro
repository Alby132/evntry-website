---
import BaseLayout from '../layouts/BaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Evntry",
    "url": "https://evntry.app",
    "description": "Simple ticketing for independent venue owners. Sell tickets with zero fan fees, scan QR codes at the door, keep your attendee data."
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Evntry",
    "url": "https://evntry.app",
    "logo": "https://evntry.app/favicon.svg",
    "description": "Simple ticketing for independent venue owners. Set up an event in minutes, sell tickets with zero fees to fans, and scan the door from your phone.",
    "contactPoint": { "@type": "ContactPoint", "email": "hello@evntry.app", "contactType": "customer support" },
    "sameAs": ["https://instagram.com/evntry.app"]
  }
];
---
<BaseLayout
  title="Evntry — Ticketing for local venues"
  description="Simple ticketing for independent venue owners. Set up an event in minutes, sell tickets with zero fees to fans, and scan the door from your phone."
  ogTitle="Evntry — Ticketing for local venues"
  ogUrl="https://evntry.app/"
  canonical="https://evntry.app/"
  ldJson={ldJson}
  preloadImage="/app-screenshot-card.webp"
>

<style is:global>
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 56px;
    padding: 120px 6vw 80px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    width: 900px; height: 900px;
    background: radial-gradient(circle, rgba(255,92,26,0.10) 0%, transparent 65%);
    top: 50%; right: 10%;
    transform: translate(50%, -50%);
    pointer-events: none;
  }
  .hero::after {
    content: 'T';
    position: absolute;
    right: -2vw; top: 50%;
    transform: translateY(-50%);
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: clamp(280px, 40vw, 520px);
    color: rgba(255,92,26,0.045);
    line-height: 1; pointer-events: none; user-select: none; letter-spacing: -0.02em;
  }
  .hero h1 { font-size: clamp(56px, 8vw, 110px); margin-bottom: 36px; }
  .hero-sub { font-size: 18px; color: var(--muted); max-width: 480px; line-height: 1.7; margin-bottom: 36px; }
  .hero-sub strong { color: var(--text); font-weight: 500; }
  .form-wrap { max-width: 480px; }
  .hero-price-hint { font-size: 13px; color: var(--muted); margin-top: 12px; }
  .trust-row { display: flex; align-items: center; gap: 14px; margin-top: 28px; flex-wrap: wrap; }
  .trust-label { font-size: 12px; color: var(--muted); }
  .trust-pills { display: flex; gap: 8px; flex-wrap: wrap; }
  .trust-pill { font-size: 12px; color: var(--muted); background: var(--surface); border: 1px solid var(--border); padding: 4px 12px; border-radius: 20px; }
  .app-preview { position: relative; z-index: 1; }
  .app-preview-img { width: 100%; height: auto; border-radius: 12px; box-shadow: 0 24px 80px rgba(0,0,0,0.5); }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 40px; min-height: auto; padding: 100px 5vw 60px; }
    .hero::after { display: none; }
    .app-preview { display: none; }
  }
  @media (max-width: 680px) {
    .nav-link, .nav-cta { display: none; }
    .hamburger { display: flex; }
  }
</style>

<main>

<section class="hero">
  <div class="hero-content">
    <p class="eyebrow">For venue owners &amp; event organizers</p>
    <h1>Sell tickets.<br>Not your <em>time.</em></h1>
    <p class="hero-sub">
      Set up an event in under 5 minutes. Sell tickets with <strong>zero fees for your fans.</strong> Scan the door from your phone. That's it.
    </p>
    <div class="form-wrap">
      <a href="https://app.evntry.app" class="btn-primary" style="text-decoration:none;padding:14px 28px;display:inline-block;">Start selling tickets →</a>
      <p class="form-note">Free to start. No credit card needed. &nbsp;·&nbsp; <a href="https://app.evntry.app/e/jazz-trio-night-aqynwD" target="_blank" rel="noopener" style="color:var(--accent);text-decoration:none;border-bottom:1px solid rgba(255,92,26,0.35);padding-bottom:1px;">See what a ticket page looks like →</a></p>
      <p class="hero-price-hint">3% per ticket on the free plan &nbsp;·&nbsp; No fees ever for your fans</p>
    </div>
    <div class="trust-row">
      <span class="trust-label">Built for</span>
      <div class="trust-pills">
        <span class="trust-pill">Bars</span>
        <span class="trust-pill">Live music venues</span>
        <span class="trust-pill">Clubs</span>
        <span class="trust-pill">Event organizers</span>
      </div>
    </div>
  </div>
  <div class="app-preview">
    <img src="/app-screenshot-card.webp" alt="Evntry event creation form — set up an event in minutes" class="app-preview-img" width="976" height="732" fetchpriority="high">
  </div>
</section>

<div class="feature-strip">
  <span class="feature-strip-item">Zero fees for fans</span>
  <span class="feature-strip-item">QR door scanning</span>
  <span class="feature-strip-item">Set up in 5 minutes</span>
  <span class="feature-strip-item">Your attendee data, always</span>
  <span class="feature-strip-item">No lock-in contracts</span>
  <span class="feature-strip-item">Musician profiles</span>
</div>

<section>
  <p class="eyebrow">The problem</p>
  <h2>Every event.<br>The same<br><em>three problems.</em></h2>
  <p class="section-sub">Before the night, during it, and after. Evntry fixes all three.</p>
  <div class="pain-grid">
    <div class="pain-card">
      <span class="pain-num">Before the event</span>
      <h3>You never know who's actually coming</h3>
      <p>Paper lists, WhatsApp reservations, inbox messages — spread across three places. Someone says they're coming. Do they mean it? You find out at the door. A paid ticket is a real commitment. An "interested" click isn't.</p>
    </div>
    <div class="pain-card">
      <span class="pain-num">On the night</span>
      <h3>The door is always chaos</h3>
      <p>Cash box, handwritten list, someone's phone with a spreadsheet. The first 30 minutes of every event is a queue and an argument. Slow entry kills the vibe before the first song even starts.</p>
    </div>
    <div class="pain-card">
      <span class="pain-num">After the event</span>
      <h3>You have nothing to show for it</h3>
      <p>You had a great night. 150 people loved it. Then it's over — no names, no emails, no data. Next week you're back to zero, promoting to the void, hoping the same crowd sees your post.</p>
    </div>
  </div>
</section>

<div class="divider"></div>

<section>
  <p class="eyebrow">How it works</p>
  <h2>From idea<br>to door-ready<br>in <em>5 minutes</em></h2>
  <p class="section-sub">Three steps. No training required.</p>
  <div class="card-grid">
    <div class="start-card" data-num="1">
      <span class="start-step">Venue app</span>
      <h3>Create your event</h3>
      <p>Open Evntry on your phone. Add the name, date, ticket price, and a poster. Set a capacity or leave it open. Hit publish. Done.</p>
    </div>
    <div class="start-card" data-num="2">
      <span class="start-step">Fans</span>
      <h3>Share your link</h3>
      <p>You get a shareable ticket link instantly. Post it anywhere. Fans buy directly — no extra app needed, no fees added on top of your price.</p>
    </div>
    <div class="start-card" data-num="3">
      <span class="start-step">Door</span>
      <h3>Scan &amp; go</h3>
      <p>On the night, scan QR codes at the door from your phone. See live how many people have arrived. No printer, no clipboard, no chaos.</p>
    </div>
  </div>
</section>

<div class="divider"></div>

<section>
  <p class="eyebrow">Features</p>
  <h2>Everything<br>you need.<br><em>Nothing you don't.</em></h2>
  <p class="section-sub">Stripped down to what actually matters for a local venue.</p>
  <div class="diff-grid">
    <div class="diff-card">
      <div class="icon-wrap">🚫</div>
      <h3>Zero fan fees</h3>
      <p>The price you set is exactly what fans pay. No booking fee at checkout. More fans complete the purchase — less drop-off at the last step.</p>
    </div>
    <div class="diff-card">
      <div class="icon-wrap">📱</div>
      <h3>Scan the door from your phone</h3>
      <p>A dedicated fullscreen check-in view for door staff. Scan QR codes, see live attendance count, get instant pass/fail feedback. No printer, no clipboard.</p>
    </div>
    <div class="diff-card">
      <div class="icon-wrap">🔗</div>
      <h3>Your permanent venue page</h3>
      <p>Every venue gets a shareable link — put it in your Instagram bio or Linktree. Fans see all your upcoming events in one place, year-round.</p>
    </div>
    <div class="diff-card">
      <div class="icon-wrap">📊</div>
      <h3>Live sales + attendance</h3>
      <p>See tickets sold in real time before the night. Then watch the check-in counter climb as people arrive. Plan staff and bar stock with actual numbers.</p>
    </div>
    <div class="diff-card">
      <div class="icon-wrap">💾</div>
      <h3>You own your attendee data</h3>
      <p>Every buyer's name, email, and ticket status is yours — exportable as CSV anytime. No platform lock-in, no asking permission to reach your own audience.</p>
    </div>
    <div class="diff-card">
      <div class="icon-wrap">🎟</div>
      <h3>Free, paid, or pay at door</h3>
      <p>Free entry, fully ticketed, or reserve-now-pay-at-door. All three modes work. You choose per event — no extra setup for each.</p>
    </div>
  </div>
</section>

<div class="divider"></div>

<section>
  <p class="eyebrow">Get started</p>
  <h2>Up and running<br>in <em>5 minutes.</em></h2>
  <p class="section-sub">No training. No onboarding call. No credit card to start. Just create an account and go.</p>
  <div class="start-grid">
    <div class="start-card" data-num="1">
      <span class="start-step">Step 1</span>
      <h3>Create your account</h3>
      <p>Sign up free. We'll get you set up — a real person reviews every application so we can help you hit the ground running.</p>
    </div>
    <div class="start-card" data-num="2">
      <span class="start-step">Step 2</span>
      <h3>Create your first event</h3>
      <p>Add a name, date, ticket price, and capacity. Connect your Stripe account to receive payments. Your shareable ticket link is ready in under 3 minutes.</p>
    </div>
    <div class="start-card" data-num="3">
      <span class="start-step">Step 3</span>
      <h3>Share and start selling</h3>
      <p>Post your link on Instagram, WhatsApp, or your website. Fans buy in seconds — no app, no account needed. Money lands in your Stripe account directly.</p>
    </div>
  </div>
</section>

<div class="divider"></div>

<section>
  <p class="eyebrow">Money</p>
  <h2>How you<br><em>get paid.</em></h2>
  <p class="section-sub" style="max-width:560px;">Evntry never holds your money. Stripe handles every payment and deposits directly into your bank account.</p>
  <div class="card-grid">
    <div class="start-card" data-num="1">
      <span class="start-step">Step 01</span>
      <h3>You set the price</h3>
      <p>Publish your event with the ticket price you choose. Fans pay exactly that — no booking fees added on their side.</p>
    </div>
    <div class="start-card" data-num="2">
      <span class="start-step">Step 02</span>
      <h3>Stripe collects payments</h3>
      <p>Every sale goes through your connected Stripe account. Industry-standard encryption. You own the transaction.</p>
    </div>
    <div class="start-card" data-num="3">
      <span class="start-step">Step 03</span>
      <h3>Stripe pays you directly</h3>
      <p>Payouts land in your bank account on Stripe's standard schedule — typically within 2–7 days of each sale.</p>
    </div>
  </div>
</section>

<div class="divider"></div>

<section>
  <p class="eyebrow">How we compare</p>
  <h2>Evntry vs<br><em>the alternatives.</em></h2>
  <p class="section-sub">Side-by-side on the things that matter to independent venues.</p>
  <div class="compare">
    <div class="compare-row compare-header">
      <span></span>
      <span class="ev">Evntry</span>
      <span>Eventbrite</span>
      <span>Entrio</span>
    </div>
    <div class="compare-row">
      <span class="compare-feature">Fees added for fans</span>
      <span class="ev-val check">None</span>
      <span class="cross">Up to 10–15%</span>
      <span class="cross">Service fee added</span>
    </div>
    <div class="compare-row">
      <span class="compare-feature">Event setup time</span>
      <span class="ev-val check">Under 5 min</span>
      <span class="cross">Up to 30 min</span>
      <span class="cross">15–20 min</span>
    </div>
    <div class="compare-row">
      <span class="compare-feature">Runs on your phone</span>
      <span class="ev-val check">Yes</span>
      <span class="cross">Web-first</span>
      <span class="cross">Limited</span>
    </div>
    <div class="compare-row">
      <span class="compare-feature">Contracts required</span>
      <span class="ev-val check">No</span>
      <span class="cross">Sometimes</span>
      <span class="cross">Yes</span>
    </div>
    <div class="compare-row">
      <span class="compare-feature">You own attendee data</span>
      <span class="ev-val check">Always</span>
      <span class="cross">Platform retains it</span>
      <span class="cross">Shared</span>
    </div>
  </div>
  <div style="margin-top:28px;text-align:center;">
    <a href="/pricing" style="font-size:14px;color:var(--muted);border-bottom:1px solid var(--border);padding-bottom:2px;transition:color 0.15s;" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--muted)'">See full pricing →</a>
  </div>
</section>

<div class="divider"></div>

<section>
  <p class="eyebrow">From the people using it</p>
  <h2>What venue owners<br><em>are saying.</em></h2>
  <div class="testimonial-grid">
    <div class="testimonial-card">
      <p class="testimonial-text">We switched from Eventbrite after they charged our fans €3 on top of a €10 ticket. With Evntry, what we write is what they pay. Our sell-through rate went up immediately.</p>
      <div class="testimonial-author">
        <div class="testimonial-avatar">MK</div>
        <div>
          <p class="testimonial-name">Marko K.</p>
          <p class="testimonial-venue">Bar owner, Zagreb</p>
        </div>
      </div>
    </div>
    <div class="testimonial-card">
      <p class="testimonial-text">Setting up our first event took 4 minutes. I timed it. The ticket link was ready before I'd finished my coffee. We sold out in 48 hours.</p>
      <div class="testimonial-author">
        <div class="testimonial-avatar">AJ</div>
        <div>
          <p class="testimonial-name">Ana J.</p>
          <p class="testimonial-venue">Club promoter, Split</p>
        </div>
      </div>
    </div>
    <div class="testimonial-card">
      <p class="testimonial-text">Finally an app that works on my phone at the door. No laptop, no printing, no chaos. My staff scan tickets in seconds and we can see live how many have arrived.</p>
      <div class="testimonial-author">
        <div class="testimonial-avatar">TP</div>
        <div>
          <p class="testimonial-name">Tomislav P.</p>
          <p class="testimonial-venue">Live music venue, Rijeka</p>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="divider"></div>

<section>
  <p class="eyebrow">Questions</p>
  <h2>Common<br><em>questions.</em></h2>
  <div class="faq-list">
    <div class="faq-item">
      <div class="faq-q">Do fans pay extra fees?</div>
      <div class="faq-a">No. The price you set is exactly what fans pay at checkout. <strong>Evntry never adds booking fees on the fan side</strong> — no sticker shock, no drop-off at the last step.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">How quickly do I get paid?</div>
      <div class="faq-a">Via your connected Stripe account. <strong>Payouts follow Stripe's schedule</strong> — typically 2–7 business days after each sale. No waiting for a monthly settlement from a platform.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">Is there a contract or minimum commitment?</div>
      <div class="faq-a">No contract, no lock-in. <strong>Cancel anytime.</strong> The free plan stays free — you only reach out for a custom plan when you're ready to grow.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">Do I own my attendee data?</div>
      <div class="faq-a">Completely. Your attendee list — names, emails, purchase history — <strong>belongs to you and is exportable anytime.</strong> We never share it or use it for our own marketing.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">Do I need a credit card to get started?</div>
      <div class="faq-a">No. The free plan requires no card. <strong>You only need a Stripe account to receive payments</strong> from ticket sales — Stripe's setup is free and takes about 10 minutes.</div>
    </div>
  </div>
  <div style="margin-top:32px;text-align:center;">
    <a href="/pricing" style="font-size:14px;color:var(--muted);border-bottom:1px solid var(--border);padding-bottom:2px;transition:color 0.15s;" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--muted)'">See full pricing &amp; FAQ →</a>
  </div>
</section>

<section class="cta-band">
  <p class="eyebrow">Get started</p>
  <h2>Your first event<br>is <em>minutes away.</em></h2>
  <p class="section-sub">Create an account, set up an event, and start selling tickets — all for free. No contracts, no approval needed.</p>
  <div class="form-wrap">
    <a href="https://app.evntry.app" class="btn-primary" style="text-decoration:none;padding:14px 28px;display:inline-block;">Create free account →</a>
    <p class="form-note" style="text-align:center;margin-top:14px;">No credit card required. One free event a month to start.</p>
  </div>
</section>

</main>

<div id="sticky-cta">
  <p>Ready to sell tickets without the fees?</p>
  <a href="https://app.evntry.app" class="sticky-btn">Start selling tickets →</a>
</div>

<script>
  document.querySelectorAll('.faq-q').forEach(function(q) {
    q.addEventListener('click', function() {
      q.closest('.faq-item').classList.toggle('open');
    });
  });
  (function() {
    var hero = document.querySelector('.hero');
    var bar  = document.getElementById('sticky-cta');
    if (!hero || !bar) return;
    var obs = new IntersectionObserver(function(entries) {
      bar.classList.toggle('visible', !entries[0].isIntersecting);
    }, { threshold: 0 });
    obs.observe(hero);
  })();
</script>
</BaseLayout>
