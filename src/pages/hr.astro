---
import BaseLayout from '../layouts/BaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Evntry",
    "url": "https://evntry.app",
    "description": "Jednostavna prodaja ulaznica za klubove i barove. Bez naknada za goste, QR skeniranje na ulazu, podaci o gostima ostaju vaši."
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Evntry",
    "url": "https://evntry.app",
    "logo": "https://evntry.app/logo.png",
    "description": "Jednostavna prodaja ulaznica za klubove, barove i organizatore. Event postavite za 5 minuta, prodajete ulaznice bez naknada za goste i skenirate ulaz mobitelom.",
    "contactPoint": { "@type": "ContactPoint", "email": "hello@evntry.app", "contactType": "customer support" },
    "sameAs": ["https://instagram.com/evntry.app"]
  }
];
---
<BaseLayout
  title="Evntry — Ulaznice za klubove, barove i koncerte"
  description="Jednostavna prodaja ulaznica za klubove, barove i organizatore. Event postavite za 5 minuta, prodajete ulaznice bez naknada za goste i skenirate ulaz mobitelom."
  lang="hr"
  alternates={[{ hreflang: 'en', href: 'https://evntry.app/' }, { hreflang: 'hr', href: 'https://evntry.app/hr' }, { hreflang: 'x-default', href: 'https://evntry.app/' }]}
  ogTitle="Evntry — Ulaznice za klubove, barove i koncerte"
  ogUrl="https://evntry.app/hr"
  canonical="https://evntry.app/hr"
  ldJson={ldJson}
  preloadImage="/app-screenshot-card.webp"
>

<style is:global>
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 56px;
    padding: 120px 6vw 80px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    width: 900px; height: 900px;
    background: radial-gradient(circle, rgba(255,92,26,0.10) 0%, transparent 65%);
    top: 50%; right: 10%;
    transform: translate(50%, -50%);
    pointer-events: none;
  }
  .hero::after {
    content: 'T';
    position: absolute;
    right: -2vw; top: 50%;
    transform: translateY(-50%);
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: clamp(280px, 40vw, 520px);
    color: rgba(255,92,26,0.045);
    line-height: 1; pointer-events: none; user-select: none; letter-spacing: -0.02em;
  }
  .hero h1 { font-size: clamp(56px, 8vw, 110px); margin-bottom: 36px; }
  .hero-sub { font-size: 18px; color: var(--muted); max-width: 480px; line-height: 1.7; margin-bottom: 36px; }
  .hero-sub strong { color: var(--text); font-weight: 500; }
  .form-wrap { max-width: 480px; }
  .hero-pricing {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 22px;
    overflow: hidden;
    background: rgba(17,17,17,0.82);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .hero-price-item { padding: 14px 16px; min-width: 0; }
  .hero-price-item + .hero-price-item { border-left: 1px solid var(--border); }
  .hero-price-label {
    display: block;
    margin-bottom: 3px;
    color: var(--accent);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }
  .hero-price-main { display: block; color: var(--text); font-size: 14px; font-weight: 600; line-height: 1.4; }
  .hero-price-detail { display: block; margin-top: 3px; color: var(--muted); font-size: 11px; line-height: 1.45; }
  .hero-price-link {
    grid-column: 1 / -1;
    padding: 10px 16px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 12px;
    text-align: center;
    transition: color 0.15s, background 0.15s;
  }
  .hero-price-link:hover { color: var(--text); background: var(--surface2); }
  .hero-stripe-note { margin-top: 8px; color: var(--muted); font-size: 11px; line-height: 1.45; }
  .trust-row { display: flex; align-items: center; gap: 14px; margin-top: 28px; flex-wrap: wrap; }
  .trust-label { font-size: 12px; color: var(--muted); }
  .trust-pills { display: flex; gap: 8px; flex-wrap: wrap; }
  .trust-pill { font-size: 12px; color: var(--muted); background: var(--surface); border: 1px solid var(--border); padding: 4px 12px; border-radius: 20px; }
  .app-preview {
    position: relative;
    z-index: 1;
    justify-self: end;
    width: min(100%, 580px);
    padding: 16px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 18px;
    background:
      linear-gradient(145deg, rgba(255,255,255,0.08), transparent 32%),
      linear-gradient(135deg, rgba(255,92,26,0.12), rgba(17,17,17,0.92) 58%);
    box-shadow:
      0 32px 90px rgba(0,0,0,0.54),
      0 0 0 8px rgba(255,255,255,0.018),
      0 0 80px rgba(255,92,26,0.10);
  }
  .app-preview::before {
    content: 'EVENT SETUP';
    position: absolute;
    inset: auto;
    top: -10px;
    left: 30px;
    z-index: 3;
    padding: 4px 9px;
    border: 1px solid rgba(255,92,26,0.28);
    border-radius: 4px;
    background: var(--bg);
    color: var(--accent);
    font-family: 'Fira Code', monospace;
    font-size: 9px;
    letter-spacing: 0.14em;
  }
  .app-preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 2px 4px 12px;
    color: var(--muted);
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .app-preview-window { display: flex; align-items: center; gap: 6px; }
  .app-preview-window i {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 10px 0 0 rgba(255,255,255,0.22), 20px 0 0 rgba(255,255,255,0.12);
  }
  .app-preview-status { color: #9ac7a5; white-space: nowrap; }
  .app-preview-shell {
    position: relative;
    padding: 8px;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 11px;
    background: rgba(4,4,4,0.72);
  }
  .app-preview-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 10px;
    background: linear-gradient(110deg, rgba(255,255,255,0.04), transparent 35%);
    pointer-events: none;
  }
  .app-preview-img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.5);
  }
  .app-preview-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 4px 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.4;
  }
  .app-preview-footer span { display: inline-flex; align-items: center; gap: 6px; }
  .app-preview-footer span::before { content: '✓'; color: var(--accent); font-weight: 700; }
  .app-preview-footer strong { color: var(--text); font-weight: 500; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 40px; min-height: auto; padding: 100px 5vw 60px; }
    .hero::after { display: none; }
    .app-preview { justify-self: stretch; width: 100%; padding: 10px; border-radius: 14px; }
    .app-preview-footer { flex-wrap: wrap; gap: 6px 14px; }
    .app-preview::before { display: none; }
  }
  @media (max-width: 680px) {
    .nav-link, .nav-cta { display: none; }
    .hamburger { display: flex; }
  }
  @media (max-width: 440px) {
    .hero-pricing { grid-template-columns: 1fr; }
    .hero-price-item + .hero-price-item { border-left: 0; border-top: 1px solid var(--border); }
  }
</style>

<main>

<section class="hero">
  <div class="hero-content">
    <p class="eyebrow">Za klubove, barove i organizatore</p>
    <h1>Prodajte ulaznice.<br>Ne svoje <em>vrijeme.</em></h1>
    <p class="hero-sub">
      Event postavite za manje od 5 minuta. Prodajete ulaznice <strong>bez ikakvih naknada za goste.</strong> Ulaz skenirate mobitelom. To je to.
    </p>
    <div class="form-wrap">
      <a href="https://app.evntry.app/register" class="btn-primary" style="text-decoration:none;padding:14px 28px;display:inline-block;">Počnite prodavati ulaznice →</a>
      <p class="form-note">Besplatan početak. Bez kreditne kartice. &nbsp;·&nbsp; <a href="/ticket-preview" target="_blank" rel="noopener" style="color:var(--accent);text-decoration:none;border-bottom:1px solid rgba(255,92,26,0.35);padding-bottom:1px;">Pogledajte kako izgleda stranica s ulaznicom →</a></p>
      <div class="hero-pricing" aria-label="Pregled cijena">
        <div class="hero-price-item">
          <span class="hero-price-label">Prvi event besplatno</span>
          <span class="hero-price-main">Besplatne ili plaćene ulaznice</span>
          <span class="hero-price-detail">0% Evntry naknade na prvi event</span>
        </div>
        <div class="hero-price-item">
          <span class="hero-price-label">Pro</span>
          <span class="hero-price-main">Cijena po dogovoru</span>
          <span class="hero-price-detail">Za prostore koji organiziraju više evenata</span>
        </div>
        <a href="/pricing" class="hero-price-link">Cijene i česta pitanja →</a>
      </div>
      <p class="hero-stripe-note">Za plaćene ulaznice vrijede standardne Stripe naknade za obradu plaćanja.</p>
    </div>
    <div class="trust-row">
      <span class="trust-label">Za</span>
      <div class="trust-pills">
        <span class="trust-pill">Barove</span>
        <span class="trust-pill">Koncertne prostore</span>
        <span class="trust-pill">Klubove</span>
        <span class="trust-pill">Organizatore</span>
      </div>
    </div>
  </div>
  <div class="app-preview">
    <div class="app-preview-header">
      <div class="app-preview-window"><i aria-hidden="true"></i><span>evntry.app / create</span></div>
      <span class="app-preview-status">Spremno za objavu</span>
    </div>
    <div class="app-preview-shell">
      <img src="/app-screenshot-card.webp" alt="Evntry obrazac za kreiranje eventa — postavljanje za nekoliko minuta" class="app-preview-img" width="976" height="732" fetchpriority="high">
    </div>
    <div class="app-preview-footer">
      <span><strong>Postavljeno za manje od 5 minuta</strong></span>
      <span>Objavite kad ste spremni</span>
    </div>
  </div>
</section>

<div class="feature-strip">
  <span class="feature-strip-item">Bez naknada za goste</span>
  <span class="feature-strip-item">QR skeniranje na ulazu</span>
  <span class="feature-strip-item">Postavljanje za 5 minuta</span>
  <span class="feature-strip-item">Podaci o gostima su vaši</span>
  <span class="feature-strip-item">Bez ugovorne obveze</span>
  <span class="feature-strip-item">Plaćanje na ulazu</span>
</div>

<section>
  <p class="eyebrow">Problem</p>
  <h2>Svaki event.<br>Ista<br><em>tri problema.</em></h2>
  <p class="section-sub">Prije večeri, tijekom nje i nakon. Evntry rješava sva tri.</p>
  <div class="pain-grid">
    <div class="pain-card">
      <span class="pain-num">Prije eventa</span>
      <h3>Nikad ne znate tko će stvarno doći</h3>
      <p>Papirnati popisi, rezervacije na WhatsAppu, poruke u inboxu — sve razbacano na tri mjesta. Netko kaže da dolazi. Misli li ozbiljno? Saznat ćete na ulazu. Plaćena ulaznica je prava obveza. Klik na „zainteresiran” nije.</p>
    </div>
    <div class="pain-card">
      <span class="pain-num">Na večer eventa</span>
      <h3>Na ulazu je uvijek kaos</h3>
      <p>Kutija s gotovinom, popis pisan rukom, nečiji mobitel s tablicom. Prvih 30 minuta svakog eventa je red i prepirka. Spor ulaz ubije atmosferu prije nego što krene prva pjesma.</p>
    </div>
    <div class="pain-card">
      <span class="pain-num">Nakon eventa</span>
      <h3>Ne ostane vam ništa</h3>
      <p>Imali ste odličnu večer. 150 ljudi je uživalo. Onda je gotovo — nema imena, nema mailova, nema podataka. Sljedeći tjedan krećete od nule, promovirate u prazno i nadate se da će ista ekipa vidjeti vašu objavu.</p>
    </div>
  </div>
</section>

<div class="divider"></div>

<section id="how-it-works">
  <p class="eyebrow">Kako funkcionira</p>
  <h2>Od ideje<br>do spremnog ulaza<br>za <em>5 minuta</em></h2>
  <p class="section-sub">Tri koraka. Bez obuke.</p>
  <div class="card-grid">
    <div class="start-card" data-num="1">
      <span class="start-step">Aplikacija</span>
      <h3>Kreirajte event</h3>
      <p>Otvorite Evntry na mobitelu. Dodajte naziv, datum, cijenu ulaznice i plakat. Postavite kapacitet ili ga ostavite otvorenim. Kliknite objavi. Gotovo.</p>
    </div>
    <div class="start-card" data-num="2">
      <span class="start-step">Gosti</span>
      <h3>Podijelite link</h3>
      <p>Odmah dobivate link za ulaznice. Objavite ga bilo gdje. Gosti kupuju izravno — bez dodatne aplikacije i bez naknada na vašu cijenu.</p>
    </div>
    <div class="start-card" data-num="3">
      <span class="start-step">Ulaz</span>
      <h3>Skeniraj i uđi</h3>
      <p>Na večer eventa skenirate QR kodove na ulazu mobitelom. Uživo vidite koliko je ljudi stiglo. Bez printera, bez popisa, bez kaosa.</p>
    </div>
  </div>
</section>

<div class="divider"></div>

<section>
  <p class="eyebrow">Mogućnosti</p>
  <h2>Sve što<br>trebate.<br><em>Ništa više.</em></h2>
  <p class="section-sub">Samo ono što je stvarno bitno za lokalni klub ili bar.</p>
  <div class="diff-grid">
    <div class="diff-card">
      <div class="icon-wrap"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 0 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 0 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="m9 9 6 6"/><path d="m15 9-6 6"/></svg></div>
      <h3>Bez naknada za goste</h3>
      <p>Cijena koju postavite je točno ono što gosti plate. Bez naknade na blagajni. Više gostiju dovrši kupnju — manje odustajanja u zadnjem koraku.</p>
    </div>
    <div class="diff-card">
      <div class="icon-wrap"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 7h2v2H9z"/><path d="M13 7h2v2h-2z"/><path d="M9 11h2v2H9z"/><path d="M12 18h.01"/></svg></div>
      <h3>Skenirajte ulaz mobitelom</h3>
      <p>Poseban prikaz preko cijelog ekrana za osoblje na ulazu. Skenirajte QR kodove, pratite broj gostiju uživo i odmah vidite je li ulaznica valjana. Bez printera, bez popisa.</p>
    </div>
    <div class="diff-card">
      <div class="icon-wrap"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></div>
      <h3>Stalna stranica vašeg prostora</h3>
      <p>Svaki prostor dobiva svoj link — stavite ga u Instagram bio ili Linktree. Gosti vide sve vaše nadolazeće evente na jednom mjestu, cijele godine.</p>
    </div>
    <div class="diff-card">
      <div class="icon-wrap"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 16v-5"/><path d="M12 16V8"/><path d="M17 16v-3"/></svg></div>
      <h3>Prodaja i dolasci uživo</h3>
      <p>Pratite prodane ulaznice u stvarnom vremenu prije večeri. Zatim gledajte kako brojač raste dok ljudi dolaze. Planirajte osoblje i zalihe šanka prema stvarnim brojkama.</p>
    </div>
    <div class="diff-card">
      <div class="icon-wrap"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></svg></div>
      <h3>Podaci o gostima su vaši</h3>
      <p>Ime, e-mail i status ulaznice svakog kupca su vaši — izvoz u CSV bilo kada. Bez vezivanja za platformu i bez traženja dopuštenja da dođete do vlastite publike.</p>
    </div>
    <div class="diff-card">
      <div class="icon-wrap"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg></div>
      <h3>Besplatno, plaćeno ili na ulazu</h3>
      <p>Slobodan ulaz, plaćene ulaznice ili „rezerviraj sada, plati na ulazu”. Sva tri načina rade. Birate za svaki event, bez dodatnog postavljanja.</p>
    </div>
  </div>
</section>

<div class="divider"></div>

<section>
  <p class="eyebrow">Usporedba</p>
  <h2>Evntry i<br><em>alternative.</em></h2>
  <p class="section-sub">Usporedba onoga što je bitno nezavisnim klubovima i barovima.</p>
  <div class="compare">
    <div class="compare-row compare-header">
      <span></span>
      <span class="ev">Evntry</span>
      <span>Eventbrite</span>
      <span>Entrio</span>
    </div>
    <div class="compare-row">
      <span class="compare-feature">Naknade za goste</span>
      <span class="ev-val check">Nema</span>
      <span class="cross">Dodaju se naknade</span>
      <span class="cross">Dodaje se naknada</span>
    </div>
    <div class="compare-row">
      <span class="compare-feature">Postavljanje eventa</span>
      <span class="ev-val check">Do 5 min</span>
      <span class="cross">Dulje</span>
      <span class="cross">Dulje</span>
    </div>
    <div class="compare-row">
      <span class="compare-feature">Radi na mobitelu</span>
      <span class="ev-val check">Da</span>
      <span class="cross">Prvenstveno web</span>
      <span class="cross">Ograničeno</span>
    </div>
    <div class="compare-row">
      <span class="compare-feature">Potreban ugovor</span>
      <span class="ev-val check">Ne</span>
      <span class="cross">Ponekad</span>
      <span class="cross">Često</span>
    </div>
    <div class="compare-row">
      <span class="compare-feature">Podaci o gostima su vaši</span>
      <span class="ev-val check">Uvijek</span>
      <span class="cross">Dijele se s platformom</span>
      <span class="cross">Dijele se</span>
    </div>
  </div>
  <p style="margin-top:16px;text-align:center;font-size:12px;color:var(--muted);">Prema javno dostupnim informacijama, studeni 2026. Naknade i uvjeti ovise o eventu i organizatoru.</p>
  <div style="margin-top:28px;text-align:center;">
    <a href="/pricing" style="font-size:14px;color:var(--muted);border-bottom:1px solid var(--border);padding-bottom:2px;transition:color 0.15s;" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--muted)'">Pogledajte cijene →</a>
  </div>
</section>

<div class="divider"></div>

<section>
  <p class="eyebrow">Osnivački partneri</p>
  <h2>Gradimo ga s prvim<br><em>prostorima u Hrvatskoj.</em></h2>
  <p class="section-sub">Evntry radi i već se koristi na pravim eventima. Uključujemo malu grupu osnivačkih partnera koji pomažu oblikovati proizvod, a zauzvrat dobivaju osnivačku cijenu.</p>
  <div class="testimonial-grid">
    <div class="testimonial-card">
      <p class="testimonial-name">Osnivačka cijena, zaključana</p>
      <p class="testimonial-venue">Prvi partneri zadržavaju osnivačku cijenu na paketu koji odaberu, dokle god ostanu s nama.</p>
    </div>
    <div class="testimonial-card">
      <p class="testimonial-name">Izravan kontakt s osnivačem</p>
      <p class="testimonial-venue">Pomoć s postavljanjem prije prvog eventa i stvarna osoba koju možete nazvati na večer eventa.</p>
    </div>
    <div class="testimonial-card">
      <p class="testimonial-name">Vi odlučujete što gradimo dalje</p>
      <p class="testimonial-venue">Vaše povratne informacije određuju plan razvoja, od alata za ulaz do mogućnosti za glazbenike i publiku.</p>
    </div>
